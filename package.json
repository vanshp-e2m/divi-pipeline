{
  "name": "figma2divi",
  "version": "0.3.1",
  "description": "Figma -> normalized IR -> HTML preview -> Divi 4 page compiler with a full visual/responsive QA and repair loop",
  "type": "module",
  "bin": {
    "f2d": "bin/f2d.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.mjs\"",
    "test:all": "node --test --test-concurrency=1 \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\""
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "ajv": "^8.17.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "ssim.js": "^3.5.0"
  }
}
